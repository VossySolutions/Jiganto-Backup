# Copy to .env and fill in values (never commit .env — it is gitignored)

# =============================================================================
# REQUIRED — production & modules 6–20 (CRM → Templates)
# =============================================================================

DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=5000
NODE_ENV=development

# Supabase → Settings → API (project URL, not /rest/v1/)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Must be false in production (uses Supabase auth)
ENABLE_DEV_LOGIN=false

# After first deploy: run scripts/sql/sync-auth-users.sql in Supabase SQL Editor
# (keeps public.users in sync with auth.users — required for FKs)

# =============================================================================
# RECOMMENDED — production URLs (emails, survey links, portfolio reports, CSAT)
# =============================================================================

# APP_PUBLIC_URL=https://app.yourdomain.com
# APP_URL=https://app.yourdomain.com
# PUBLIC_APP_URL=https://app.yourdomain.com
# VITE_APP_URL=https://app.yourdomain.com

# =============================================================================
# OPTIONAL — server tuning
# =============================================================================

# HOST=0.0.0.0
# DATABASE_POOL_MAX=5
# Optional: set if Vite HMR websocket fails (default localhost). Use 127.0.0.1 if needed.
# VITE_HMR_HOST=localhost

# Default name when bootstrapping first admin (if user leaves field blank)
# AUTH_TENANT_NAME=My Organisation

# Dev-only login bypass (never enable in production)
# ENABLE_DEV_LOGIN=true
# AUTH_USER_EMAIL=admin@localhost
# AUTH_USER_FIRST_NAME=Admin
# AUTH_USER_LAST_NAME=User
# AUTH_PLATFORM_ROLE=si_super_admin
# AUTH_TENANT_SLUG=my-org

# Demo / smoke scripts (not required for runtime)
# SEED_TENANT_ID=1
# FORCE=1

# Optional: disable background jobs (portfolio health snapshots, survey close, eSign reminders)
# Leave unset in production — jobs run daily when server is up.
# DISABLE_PLATFORM_JOBS=true

# =============================================================================
# OPTIONAL — email (invites, eSign, portfolio report delivery)
# =============================================================================

# Resend (https://resend.com) — preferred
# RESEND_API_KEY=re_xxxx
# INVITE_EMAIL_FROM=Jiganto <noreply@yourdomain.com>

# Or SMTP (password not stored in DB; configure host in Settings → Integrations)
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Jiganto <noreply@yourdomain.com>

# =============================================================================
# OPTIONAL — OpenAI (AI features degrade to rule-based fallbacks without a key)
# Used by: Resource Planning AI planner, Business insights, Portfolio narrative,
# Surveys AI, Test Management test generation, Dashboard AI builder, global assistant.
# =============================================================================

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# OPTIONAL — Finance module (Module 07) — ERP integrations
# Generic webhook works via Finance → Integrations UI (no env vars).
# Xero / QuickBooks OAuth requires server keys (OAuth flow not fully wired yet):
# =============================================================================

# XERO_CLIENT_ID=your-xero-client-id
# XERO_CLIENT_SECRET=your-xero-client-secret
# XERO_REDIRECT_URI=https://app.yourdomain.com/api/finance/erp/xero/callback

# QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
# QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
# QUICKBOOKS_REDIRECT_URI=https://app.yourdomain.com/api/finance/erp/quickbooks/callback

# NETSUITE_ACCOUNT_ID=your-netsuite-account
# NETSUITE_CONSUMER_KEY=your-consumer-key
# NETSUITE_CONSUMER_SECRET=your-consumer-secret

# Outbound ERP webhook signing (optional)
# WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret

# =============================================================================
# OPTIONAL — Customer Management (Stripe billing sync)
# =============================================================================

# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# =============================================================================
# OPTIONAL — Chat module (Module 02)
# =============================================================================

# CHAT_AI_ENABLED=true
# CHAT_USE_SUPABASE_REALTIME=true
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# TEAMS_INCOMING_WEBHOOK_URL=https://outlook.office.com/webhook/...
# CHAT_BRIDGE_INCOMING_SECRET=change-me-bridge-secret
# CHAT_MAX_ATTACHMENT_MB=50
# CHAT_MAX_ATTACHMENTS_PER_MESSAGE=5
# CHAT_JIGANTO_BOT_USER_ID=jiganto-bot

# =============================================================================
# OPTIONAL — e-Sign module (Module 18)
# =============================================================================

# QTSP_PROVIDER=none
# QTSP_PROVIDER=mock
# QTSP_API_KEY=your-qtsp-api-key
# DOCUSIGN_INTEGRATION_KEY=your-docusign-integration-key
# DOCUSIGN_ACCOUNT_ID=your-docusign-account-id
# DOCUSIGN_USER_ID=your-docusign-user-id

# =============================================================================
# OPTIONAL — smoke / CI tests (dev only; server must be running)
# =============================================================================

# SMOKE_BASE_URL=http://127.0.0.1:5000
# SMOKE_LOGIN_PRESET=si_super_admin
# SMOKE_BEARER_TOKEN=eyJ...
# SMOKE_SUPABASE_EMAIL=test@email.com
# SMOKE_SUPABASE_PASSWORD=your-password
# SMOKE_TENANT_ID=1
