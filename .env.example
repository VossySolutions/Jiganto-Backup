# Copy to .env and fill in values

DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SESSION_SECRET=change-me-to-a-long-random-string
PORT=5000
# Optional: set if Vite HMR websocket fails (default localhost). Use 127.0.0.1 if needed.
# VITE_HMR_HOST=localhost

# Supabase → Settings → API (project URL, not /rest/v1/)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

ENABLE_DEV_LOGIN=false

# Optional: seed "Demo Corp" + sample boards on first server start (dev only)
# SEED_DEMO_TENANT=false

# Default name when bootstrapping first admin (if user leaves field blank)
# AUTH_TENANT_NAME=My Organisation

# After first deploy: run scripts/sql/sync-auth-users.sql in Supabase SQL Editor
# (keeps public.users in sync with auth.users — required for FKs)

# Optional: public URL for invite emails (defaults to http://localhost:PORT)
# APP_PUBLIC_URL=https://app.yourdomain.com
# APP_URL=https://app.yourdomain.com
# PUBLIC_APP_URL=https://app.yourdomain.com

# Optional: Customer Management — Stripe (Billing overview → Sync from Stripe)
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Optional: send emails via Resend (invites, grant/trial notifications)
# https://resend.com
# RESEND_API_KEY=re_xxxx
# INVITE_EMAIL_FROM=Jiganto <billing@yourdomain.com>

# Optional: HMAC signature on outbound webhooks (X-Jiganto-Signature header)
# WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret

# Optional: custom SMTP (Settings → Integrations). Password not stored in DB.
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Jiganto <noreply@yourdomain.com>

# Optional: disable background jobs (notification digests)
# DISABLE_PLATFORM_JOBS=true

# --- OpenAI (shared across modules) ---
# Required for: global AI Assistant, Chat @jiganto + summarise, Dashboard AI builder,
# Business AI insights/assist, Customer Management survey AI generation.
# Documents module does not use OpenAI.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Chat module (Module 02 extended) ---

# AI summarisation + @jiganto replies (enabled when OPENAI_API_KEY is set)
# CHAT_AI_ENABLED=true

# Supabase Realtime for chat_messages (default on; set false to use WebSocket only)
# Enable publication: Supabase Dashboard → Database → Replication → chat_messages
# CHAT_USE_SUPABASE_REALTIME=true

# Slack / Teams bridge (outbound forward + optional inbound webhook)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# TEAMS_INCOMING_WEBHOOK_URL=https://outlook.office.com/webhook/...
# CHAT_BRIDGE_INCOMING_SECRET=change-me-bridge-secret

# Attachments (stored under uploads/chat/)
# CHAT_MAX_ATTACHMENT_MB=50
# CHAT_MAX_ATTACHMENTS_PER_MESSAGE=5

# Bot user id for AI + bridge messages (created on server start if missing)
# CHAT_JIGANTO_BOT_USER_ID=jiganto-bot

# --- e-Sign module (Module 18) ---

# Public base URL for signing links in emails (defaults to http://localhost:5000)
# APP_URL=http://localhost:5000

# Signing invitation / reminder / OTP emails (uses RESEND_API_KEY or SMTP above)
# RESEND_API_KEY=re_xxxx
# INVITE_EMAIL_FROM=Jiganto e-Sign <esign@yourdomain.com>
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Jiganto e-Sign <esign@yourdomain.com>

# QTSP / Advanced Electronic Signature (AdES) — Phase 3
# none = SES only (default) | mock = dev timestamps in audit trail | docusign | globalsign
# QTSP_PROVIDER=none
# QTSP_PROVIDER=mock
# QTSP_API_KEY=your-qtsp-api-key
# DOCUSIGN_INTEGRATION_KEY=your-docusign-integration-key
# DOCUSIGN_ACCOUNT_ID=your-docusign-account-id
# DOCUSIGN_USER_ID=your-docusign-user-id

# Optional: smoke tests against a running dev server
# SMOKE_BASE_URL=http://127.0.0.1:5000
# SMOKE_LOGIN_PRESET=si_super_admin
# SMOKE_BEARER_TOKEN=eyJ...           # Supabase access token (optional)
# SMOKE_SUPABASE_EMAIL=test@email.com # Used with SMOKE_SUPABASE_PASSWORD when Supabase auth is enabled
# SMOKE_SUPABASE_PASSWORD=your-password
