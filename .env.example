# Copy to .env and fill in values

DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SESSION_SECRET=change-me-to-a-long-random-string
PORT=5000

# Supabase → Settings → API (project URL, not /rest/v1/)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

ENABLE_DEV_LOGIN=false

# Optional: seed "Demo Corp" + sample boards on first server start (dev only)
# SEED_DEMO_TENANT=false

# Default name when bootstrapping first admin (if user leaves field blank)
# AUTH_TENANT_NAME=My Organisation

# After first deploy: run scripts/sql/sync-auth-users.sql in Supabase SQL Editor
# (keeps public.users in sync with auth.users — required for FKs)

# Optional: public URL for invite emails (defaults to http://localhost:PORT)
# APP_PUBLIC_URL=https://app.yourdomain.com

# Optional: Customer Management — Stripe (Billing overview → Sync from Stripe)
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Optional: send emails via Resend (invites, grant/trial notifications)
# https://resend.com
# RESEND_API_KEY=re_xxxx
# INVITE_EMAIL_FROM=Jiganto <billing@yourdomain.com>

# Optional: HMAC signature on outbound webhooks (X-Jiganto-Signature header)
# WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret

# Optional: custom SMTP (Settings → Integrations). Password not stored in DB.
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Jiganto <noreply@yourdomain.com>

# Optional: disable background jobs (notification digests)
# DISABLE_PLATFORM_JOBS=true
